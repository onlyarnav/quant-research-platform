[Unit]
Description=Quant Research Platform Docker Compose Stack
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/quant
ExecStart=/usr/bin/docker compose -f /opt/quant/docker-compose.prod.yml up -d
ExecStop=/usr/bin/docker compose -f /opt/quant/docker-compose.prod.yml down
Restart=on-failure
RestartSec=10s

[Install]
WantedBy=multi-user.target
