# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/quantdb
MLFLOW_DB_URL=postgresql://postgres:postgres@postgres:5432/mlflowdb

# External API Keys
ALPHA_VANTAGE_KEY=
FRED_API_KEY=
NEWS_API_KEY=

# Data Settings
DATA_START_DATE=2015-01-01
DATA_UPDATE_MODE=incremental
DATA_REFRESH_INTERVAL_HOURS=24

# Market Universe
MARKET=NSE
STOCK_UNIVERSE=NIFTY500

# ML Settings
MODEL_LOOKBACK_WINDOW=252
MODEL_PREDICTION_HORIZON=1
MODEL_RETRAIN_INTERVAL_DAYS=7
TRAIN_SPLIT_RATIO=0.70
VAL_SPLIT_RATIO=0.15

# Backtesting
TRANSACTION_COST=0.001
SLIPPAGE=0.0005
INITIAL_CAPITAL=1000000.0
BACKTEST_RESULTS_PATH=data/backtests
BACKTEST_EXECUTION_LAG=0
BACKTEST_CASH_RESERVE=0.0
BACKTEST_ALLOCATION_METHOD=fixed_notional
BACKTEST_REBALANCE_FREQUENCY=on_signal
BACKTEST_REBALANCE_TOLERANCE=0.0025
BACKTEST_STOP_LOSS=
BACKTEST_TAKE_PROFIT=
BACKTEST_LOOKBACK_WINDOW=60

# Benchmark & Risk Analytics
BENCHMARK_SYMBOL=NIFTY50
TRADING_DAYS_PER_YEAR=252
ROLLING_WINDOW=63
VAR_CONFIDENCE=0.95

# Pipeline Runs
PIPELINE_RUNS_PATH=data/pipeline_runs

# Dashboard & API
API_HOST=127.0.0.1
API_PORT=8000
DASHBOARD_API_URL=
DASHBOARD_API_KEY=
DASHBOARD_CACHE_TTL_SECONDS=60

# Portfolio
PORTFOLIO_RISK_FREE_RATE=0.07
MAX_POSITION_SIZE=0.05

# Pipeline Automation
PIPELINE_RUN_TIME=18:30
PIPELINE_TIMEZONE=Asia/Kolkata

# MLflow
MLFLOW_TRACKING_URI=http://localhost:5000

# Logging
LOG_LEVEL=INFO
LOG_FILE_PATH=logs/pipeline.log