# =================================================================
# 1. DATABASE CONFIGURATION
# =================================================================
# Format: postgresql+psycopg2://<USER>:<PASSWORD>@<HOST>:<PORT>/<DB_NAME>
# Change "postgres:postgres" if you set a custom password during PostgreSQL install
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/quant_research
MLFLOW_DB_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/mlflowdb

# =================================================================
# 2. FASTAPI & STREAMLIT DASHBOARD
# =================================================================
APP_ENV=dev
API_HOST=127.0.0.1
API_PORT=8001
DASHBOARD_API_URL=http://127.0.0.1:8001
DASHBOARD_API_KEY=
DASHBOARD_CACHE_TTL_SECONDS=60
DASHBOARD_READ_ONLY=False
# Leave empty unless you want a password lock on the UI
DASHBOARD_PASSWORD=

# =================================================================
# 3. MLFLOW EXPERIMENT TRACKING
# =================================================================
# Uses local SQLite store for simplicity
MLFLOW_TRACKING_URI=sqlite:///mlflow.db
MLFLOW_EXPERIMENT_NAME=quant-ml-research

# =================================================================
# 4. MARKET & DATA LAKE SETTINGS
# =================================================================
MARKET=NSE
STOCK_UNIVERSE=NIFTY500
DATA_START_DATE=2015-01-01
DATA_UPDATE_MODE=incremental
DATA_REFRESH_INTERVAL_HOURS=24

# External API Keys (Optional - yfinance works without these)
ALPHA_VANTAGE_KEY=
FRED_API_KEY=
NEWS_API_KEY=

# =================================================================
# 5. MACHINE LEARNING & SIGNAL GENERATION
# =================================================================
MODEL_NAME=xgboost_model
FEATURE_SET_VERSION=v1
MODEL_LOOKBACK_WINDOW=252
MODEL_PREDICTION_HORIZON=1
MODEL_RETRAIN_INTERVAL_DAYS=7
TRAIN_SPLIT_RATIO=0.70
VAL_SPLIT_RATIO=0.15

# Signal Thresholds
SIGNAL_STRATEGY=topn
SIGNAL_TOP_N=5
SIGNAL_BOTTOM_N=0
SIGNAL_THRESHOLD=0.0005

# =================================================================
# 6. BACKTESTING & PORTFOLIO RISK
# =================================================================
INITIAL_CAPITAL=1000000.0
TRANSACTION_COST=0.0010
SLIPPAGE=0.0005
PORTFOLIO_RISK_FREE_RATE=0.07
MAX_POSITION_SIZE=0.05
BENCHMARK_SYMBOL=NIFTY50
TRADING_DAYS_PER_YEAR=252
ROLLING_WINDOW=63
VAR_CONFIDENCE=0.95

BACKTEST_EXECUTION_LAG=0
BACKTEST_CASH_RESERVE=0.0
BACKTEST_ALLOCATION_METHOD=fixed_notional
BACKTEST_REBALANCE_FREQUENCY=on_signal
BACKTEST_REBALANCE_TOLERANCE=0.0025
BACKTEST_STOP_LOSS=
BACKTEST_TAKE_PROFIT=
BACKTEST_LOOKBACK_WINDOW=60
BACKTEST_MAX_CONCURRENT_JOBS=1

# =================================================================
# 7. AUTOMATION PIPELINE & LOGGING
# =================================================================
PIPELINE_RUN_TIME=18:30
PIPELINE_TIMEZONE=Asia/Kolkata
LOG_LEVEL=INFO
LOG_FORMAT=text