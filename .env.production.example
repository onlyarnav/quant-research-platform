# ==============================================================================
# Quantitative AI Research Platform — Production Environment Configuration
# ==============================================================================
# Instructions:
# 1. Copy this file to /opt/quant/.env on the EC2 host.
# 2. Restrict permissions immediately: chmod 600 /opt/quant/.env
# 3. Generate secure random passwords/tokens using: openssl rand -hex 24
# 4. NEVER commit populated .env files into source control.
# ==============================================================================

# Application Environment (dev | staging | prod)
APP_ENV=prod

# Domain Name (e.g. quant.example.com or <ip-with-dashes>.sslip.io)
DOMAIN=quant.example.com

# Container Registry & Image Settings
ECR_REPO=123456789012.dkr.ecr.ap-south-1.amazonaws.com/quant-platform
IMAGE_TAG=v1.0.0

# Database Credentials
POSTGRES_USER=postgres
# Generate with: openssl rand -hex 24
POSTGRES_PASSWORD=replace_with_secure_random_postgres_password
POSTGRES_DB=quantdb
DATABASE_URL=postgresql://postgres:replace_with_secure_random_postgres_password@postgres:5432/quantdb

# MLflow Tracking Server
MLFLOW_TRACKING_URI=http://mlflow:5000

# REST API Settings
API_ROOT_PATH=/api
API_DOCS_ENABLED=false
API_WORKERS=2
API_PORT=8000
API_HOST=0.0.0.0

# Logging Configuration
LOG_FORMAT=json
LOG_LEVEL=INFO

# Dashboard Protection & Security
DASHBOARD_READ_ONLY=true
# Generate with: openssl rand -hex 16
DASHBOARD_PASSWORD=replace_with_dashboard_login_password
# Generate with: openssl rand -hex 32
DASHBOARD_API_KEY=replace_with_dashboard_api_token
DASHBOARD_API_URL=http://api:8000
DASHBOARD_CACHE_TTL_SECONDS=60

# Automated Daily Pipeline Schedule (IST)
PIPELINE_RUN_TIME=18:30
PIPELINE_TIMEZONE=Asia/Kolkata

# AWS CloudWatch & Storage
AWS_DEFAULT_REGION=ap-south-1
AWS_LOG_GROUP=/quant/prod/app
